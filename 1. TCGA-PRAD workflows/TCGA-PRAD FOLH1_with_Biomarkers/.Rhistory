width = 8,
height = 8,
dpi = 300
)
data.frame(
gene = gene,
n = nrow(df_km),
cutoff_median = med_cut,
n_low = sum(df_km$group == "Low"),
n_high = sum(df_km$group == "High"),
logrank_p = pval,
HR_high_vs_low = hr,
CI95_lower = hr_low,
CI95_upper = hr_high,
stringsAsFactors = FALSE
)
}
