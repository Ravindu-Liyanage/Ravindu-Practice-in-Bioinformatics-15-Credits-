# ---------------------------------------------------------
# Load packages
# ---------------------------------------------------------
library(SummarizedExperiment)
library(TCGAbiolinks)
library(tidyr)
library(openxlsx)
library(tidyverse)
library(ggpubr)
library(edgeR)
library(DESeq2)
library(biomaRt)
library(ReactomePA)
library(enrichplot)
library(org.Hs.eg.db)
library(ggplot2)
library(dplyr)
library(tibble)
library(stringr)
# ---------------------------------------------------------
# Read data
# ---------------------------------------------------------
tcga_obj <- readRDS("TCGA_panCancer_FOLH1.rds")
count_mat <- assay(tcga_obj)
meta <- as.data.frame(colData(tcga_obj))
meta$barcode <- rownames(meta)
gene_annot <- as.data.frame(rowData(tcga_obj))
# ---------------------------------------------------------
# Extract TCGA-PRAD samples
# ---------------------------------------------------------
meta_prad <- meta[meta$project == "TCGA-PRAD", , drop = FALSE]
prad_count_mat <- count_mat[, meta_prad$barcode, drop = FALSE]
expr_prad <- prad_count_mat
# Keep only primary tumor samples for FOLH1-high vs FOLH1-low analysis
meta_prad <- meta_prad[meta_prad$sample_type == "Primary Tumor", , drop = FALSE]
expr_prad <- expr_prad[, rownames(meta_prad), drop = FALSE]
# ---------------------------------------------------------
# Find FOLH1 row using gene_annot$gene_name
# ---------------------------------------------------------
folh1_idx <- which(gene_annot$gene_name == "FOLH1")
if (length(folh1_idx) == 0) {
stop("FOLH1 was not found in gene_annot$gene_name.")
}
if (length(folh1_idx) > 1) {
folh1_idx <- folh1_idx[1]
warning("Multiple FOLH1 rows found. Using the first one.")
}
folh1_expr <- as.numeric(expr_prad[folh1_idx, ])
# Add FOLH1 expression to metadata
meta_prad$FOLH1_expr <- folh1_expr
# Median cutoff
cutoff <- median(meta_prad$FOLH1_expr, na.rm = TRUE)
meta_prad$group <- ifelse(meta_prad$FOLH1_expr >= cutoff, "High", "Low")
meta_prad$group <- factor(meta_prad$group, levels = c("Low", "High"))
table(meta_prad$group)
# ---------------------------------------------------------
# Keep samples with non-missing group and align expression
# ---------------------------------------------------------
keep <- !is.na(meta_prad$group) & !is.na(meta_prad$FOLH1_expr)
meta_prad <- meta_prad[keep, , drop = FALSE]
expr_prad <- expr_prad[, rownames(meta_prad), drop = FALSE]
meta_prad$group <- droplevels(meta_prad$group)
# ---------------------------------------------------------
# Optional: remove FOLH1 itself from differential expression
# ---------------------------------------------------------
# If you do not want FOLH1 to dominate the DE results, uncomment:
expr_prad <- expr_prad[rownames(expr_prad) != rownames(expr_prad)[folh1_idx], , drop = FALSE]
# ---------------------------------------------------------
# Filter lowly expressed genes
# ---------------------------------------------------------
dge <- DGEList(counts = expr_prad)
dge <- calcNormFactors(dge)
cpm_mat <- cpm(dge)
mean_log2_cpm <- rowMeans(log2(cpm_mat + 1))
hist(mean_log2_cpm, breaks = 50, main = "Mean log2 CPM", xlab = "Mean log2 CPM")
filtered_expr <- expr_prad[mean_log2_cpm > 1, , drop = FALSE]
dim(filtered_expr)
# ---------------------------------------------------------
# Differential expression with edgeR
# ---------------------------------------------------------
dge <- DGEList(counts = filtered_expr)
dge <- calcNormFactors(dge)
design <- model.matrix(~ 0 + group, data = meta_prad)
colnames(design) <- levels(meta_prad$group)
design
dge <- estimateDisp(dge, design, robust = TRUE)
fit <- glmQLFit(dge, design, robust = TRUE)
if (all(c("High", "Low") %in% colnames(design))) {
contrast <- makeContrasts(High - Low, levels = design)
} else {
stop("Need High and Low groups present in the design matrix.")
}
qlf <- glmQLFTest(fit, contrast = contrast)
top_res <- topTags(qlf, n = Inf)$table
# Filter significant DEGs
sig_res <- top_res %>%
rownames_to_column("gene_id") %>%
filter(abs(logFC) > 1, FDR < 0.05)
sig_res$gene_id <- sub("\\..*", "", sig_res$gene_id)
nrow(sig_res)
head(sig_res)
# ---------------------------------------------------------
# Save DEG tables
# ---------------------------------------------------------
write.csv(top_res, "TCGA_PRAD_FOLH1_high_vs_low_all_DE_results.csv", row.names = FALSE)
write.csv(sig_res, "TCGA_PRAD_FOLH1_high_vs_low_sig_DEGs.csv", row.names = FALSE)
# ---------------------------------------------------------
# Map gene IDs to Entrez IDs
# ---------------------------------------------------------
gene_ids <- sig_res$gene_id
if (all(grepl("^ENSG", gene_ids))) {
mart <- useMart("ensembl", dataset = "hsapiens_gene_ensembl")
anno <- getBM(
attributes = c("ensembl_gene_id", "entrezgene_id", "hgnc_symbol", "description"),
filters = "ensembl_gene_id",
values = gene_ids,
mart = mart
)
anno$ensembl_gene_id <- as.character(anno$ensembl_gene_id)
sig_anno <- sig_res %>%
left_join(anno, by = c("gene_id" = "ensembl_gene_id"))
genes_entrez <- sig_anno$entrezgene_id
} else {
anno <- bitr(
gene_ids,
fromType = "SYMBOL",
toType = "ENTREZID",
OrgDb = org.Hs.eg.db
)
anno$SYMBOL <- as.character(anno$SYMBOL)
sig_anno <- sig_res %>%
left_join(anno, by = c("gene_id" = "SYMBOL"))
genes_entrez <- sig_anno$ENTREZID
}
genes_entrez <- genes_entrez[!is.na(genes_entrez)]
genes_entrez <- unique(genes_entrez)
length(genes_entrez)
write.csv(sig_anno, "TCGA_PRAD_FOLH1_high_vs_low_sig_DEGs_annotated.csv", row.names = FALSE)
# ---------------------------------------------------------
# Reactome ORA
# ---------------------------------------------------------
ora_res <- enrichPathway(
gene = genes_entrez,
organism = "human",
pvalueCutoff = 0.05,
pAdjustMethod = "BH",
readable = TRUE
)
ora_df <- as.data.frame(ora_res)
write.csv(ora_df, "TCGA_PRAD_FOLH1_high_vs_low_reactome_ORA.csv", row.names = FALSE)
if (nrow(ora_df) > 0) {
print(head(ora_df[, c("Description", "GeneRatio", "BgRatio", "pvalue", "p.adjust", "qvalue")]))
}
# ---------------------------------------------------------
# Visualizations
# ---------------------------------------------------------
if (!is.null(ora_res) && nrow(as.data.frame(ora_res)) > 0) {
p1 <- dotplot(ora_res, showCategory = 15, x = "GeneRatio") +
ggtitle("TCGA-PRAD FOLH1 High vs Low Reactome ORA dotplot") +
theme_bw() +
theme(
plot.title = element_text(face = "bold", size = 14),
axis.text.y = element_text(size = 8)
)
sim <- pairwise_termsim(ora_res)
p2 <- emapplot(sim, showCategory = 15) +
ggtitle("TCGA-PRAD FOLH1 High vs Low Reactome enrichment map") +
theme_bw() +
theme(plot.title = element_text(face = "bold", size = 14))
print(p1)
print(p2)
ggsave("TCGA_PRAD_FOLH1_high_vs_low_reactome_dotplot.png", p1, width = 10, height = 7, dpi = 300)
ggsave("TCGA_PRAD_FOLH1_high_vs_low_reactome_emap.png", p2, width = 10, height = 7, dpi = 300)
}
# ---------------------------------------------------------
# Optional: top 10 genes
# ---------------------------------------------------------
top10 <- sig_anno %>%
arrange(FDR) %>%
select(gene_id, everything()) %>%
head(10)
library(SummarizedExperiment)
library(TCGAbiolinks)
library(tidyr)
library(openxlsx)
library(tidyverse)
library(ggpubr)
library(edgeR)
library(DESeq2)
library(biomaRt)
library(ReactomePA)
library(enrichplot)
library(org.Hs.eg.db)
library(ggplot2)
library(dplyr)
library(tibble)
library(stringr)
# ---------------------------------------------------------
# Optional: top 10 genes
# ---------------------------------------------------------
top10 <- sig_anno %>%
arrange(FDR) %>%
select(gene_id, everything()) %>%
head(10)
# ---------------------------------------------------------
# Optional: top 10 genes
# ---------------------------------------------------------
top10 <- sig_anno[order(sig_anno$FDR), ]
top10 <- top10[, c("gene_id", setdiff(colnames(top10), "gene_id"))]
top10 <- head(top10, 10)
write.csv(top10, "TCGA_PRAD_FOLH1_high_vs_low_top10_sig_genes.csv", row.names = FALSE)
top10
# ===================================================================
# Ravindu: Enrichment analysis based on high and low FOLH1 expression
# ===================================================================
library(SummarizedExperiment)
library(TCGAbiolinks)
library(tidyr)
library(openxlsx)
library(tidyverse)
library(ggpubr)
library(edgeR)
library(DESeq2)
library(biomaRt)
library(ReactomePA)
library(enrichplot)
library(org.Hs.eg.db)
library(ggplot2)
library(dplyr)
library(tibble)
library(stringr)
tcga_obj <- readRDS("TCGA_panCancer_FOLH1.rds")
count_mat <- assay(tcga_obj)
meta <- as.data.frame(colData(tcga_obj))
meta$barcode <- rownames(meta)
# Extract only TCGA-PRAD samples
meta_prad <- meta[meta$project == "TCGA-PRAD", ]
prad_count_mat <- count_mat[, meta_prad$barcode]
expr_prad <- prad_count_mat
# Build grouping variable
meta_prad$group <- factor(
meta_prad$sample_type,
levels = c("Solid Tissue Normal", "Primary Tumor"),
labels = c("Normal", "Tumor")
)
table(meta_prad$group)
# Keep only Normal and Tumor samples
keep <- meta_prad$group %in% c("Normal", "Tumor")
meta_prad <- meta_prad[keep, , drop = FALSE]
expr_prad <- expr_prad[, rownames(meta_prad), drop = FALSE]
meta_prad$group <- droplevels(meta_prad$group)
# ----------------------------------
# 1) Filter lowly expressed genes
# ----------------------------------
dge <- DGEList(counts = expr_prad)
dge <- calcNormFactors(dge)
cpm_mat <- cpm(dge)
mean_log2_cpm <- rowMeans(log2(cpm_mat + 1))
hist(mean_log2_cpm, breaks = 50, main = "Mean log2 CPM", xlab = "Mean log2 CPM")
filtered_expr <- expr_prad[mean_log2_cpm > 1, ]
dim(filtered_expr)
# --------------------------------------
# 2) Differential expression with edgeR
# --------------------------------------
dge <- DGEList(counts = filtered_expr)
dge <- calcNormFactors(dge)
design <- model.matrix(~ 0 + group, data = meta_prad)
colnames(design) <- levels(meta_prad$group)
design
dge <- estimateDisp(dge, design, robust = TRUE)
fit <- glmQLFit(dge, design, robust = TRUE)
if (all(c("Tumor", "Normal") %in% colnames(design))) {
contrast <- makeContrasts(Tumor - Normal, levels = design)
}
qlf <- glmQLFTest(fit, contrast = contrast)
top_res <- topTags(qlf, n = Inf)$table
sig_res <- top_res %>%
rownames_to_column("gene_id") %>%
filter(abs(logFC) > 1, FDR < 0.05)
sig_res$gene_id <- sub("\\..*", "", sig_res$gene_id)
nrow(sig_res)
head(sig_res)
# ------------------------------
# 3) Map gene IDs to Entrez IDs
# ------------------------------
gene_ids <- sig_res$gene_id
if (all(grepl("^ENSG", gene_ids))) {
mart <- useMart("ensembl", dataset = "hsapiens_gene_ensembl")
anno <- getBM(
attributes = c("ensembl_gene_id", "entrezgene_id", "hgnc_symbol", "description"),
filters = "ensembl_gene_id",
values = gene_ids,
mart = mart
)
anno$ensembl_gene_id <- as.character(anno$ensembl_gene_id)
sig_anno <- sig_res %>%
left_join(anno, by = c("gene_id" = "ensembl_gene_id"))
genes_entrez <- sig_anno$entrezgene_id
} else {
anno <- bitr(
gene_ids,
fromType = "SYMBOL",
toType = "ENTREZID",
OrgDb = org.Hs.eg.db
)
anno$SYMBOL <- as.character(anno$SYMBOL)
sig_anno <- sig_res %>%
left_join(anno, by = c("gene_id" = "SYMBOL"))
genes_entrez <- sig_anno$ENTREZID
}
genes_entrez <- genes_entrez[!is.na(genes_entrez)]
genes_entrez <- unique(genes_entrez)
length(genes_entrez)
# -------------------
# 4) Reactome ORA
# -------------------
ora_res <- enrichPathway(
gene = genes_entrez,
organism = "human",
pvalueCutoff = 0.05,
pAdjustMethod = "BH",
readable = TRUE
)
ora_df <- as.data.frame(ora_res)
head(ora_df[, c("Description", "GeneRatio", "BgRatio", "pvalue", "p.adjust", "qvalue")])
# -------------------
# 5) Visualizations
# -------------------
p1 <- dotplot(ora_res, showCategory = 15, x = "GeneRatio") +
ggtitle("TCGA-PRAD Reactome ORA dotplot") +
theme_bw() +
theme(
plot.title = element_text(face = "bold", size = 14),
axis.text.y = element_text(size = 8)
)
p2 <- {
sim <- pairwise_termsim(ora_res)
emapplot(sim, showCategory = 15) +
ggtitle("TCGA-PRAD Reactome enrichment map") +
theme_bw() +
theme(plot.title = element_text(face = "bold", size = 14))
}
print(p1)
print(p2)
ggsave("TCGA_PRAD_reactome_dotplot.png", p1, width = 10, height = 7, dpi = 300)
ggsave("TCGA_PRAD_reactome_emap.png", p2, width = 10, height = 7, dpi = 300)
# ------------------------------
# 6) Top genes table
# ------------------------------
top10 <- sig_anno %>%
arrange(FDR) %>%
select(gene_id, everything()) %>%
head(10)
# ------------------------------
# 6) Top genes table
# ------------------------------
top10 <- sig_anno %>%
arrange(FDR) %>%
dplyr::select(gene_id, everything()) %>%
head(10)
top10
# ------------------------------------------
# 7) Save all result tables into one workbook
# ------------------------------------------
excel_sheets <- list(
All_DE_results = top_res %>% rownames_to_column("gene_id"),
Significant_DEGs = sig_res,
Annotated_DEGs = sig_anno,
Reactome_ORA = ora_df,
Top10_sig_genes = top10
)
write.xlsx(
excel_sheets,
file = "TCGA_PRAD_FOLH1_enrichment_results.xlsx",
overwrite = TRUE
)
