# -----------------------------
# 15) Plot MCP-counter scores
# -----------------------------
mcp_long <- mcp_scores_df %>%
pivot_longer(
cols = -c(sample_id, immune_group),
names_to = "cell_population",
values_to = "score"
)
p_mcp <- ggplot(mcp_long, aes(x = immune_group, y = score, fill = immune_group)) +
geom_boxplot(outlier.shape = NA) +
geom_jitter(width = 0.15, size = 0.8, alpha = 0.7) +
facet_wrap(~ cell_population, scales = "free_y") +
theme_classic() +
theme(legend.position = "none") +
labs(
x = "GSVA immune score group",
y = "MCP-counter score",
title = "MCP-counter cell populations by immune score group"
) +
scale_fill_manual(values = c("Low" = "#4575B4", "High" = "#D73027"))
ggsave(
file.path(outdir, "MCPcounter_boxplots.png"),
p_mcp, width = 12, height = 8, dpi = 300
)
mcp_pvals <- mcp_long %>%
group_by(cell_population) %>%
summarise(
p.value = wilcox.test(score ~ immune_group)$p.value,
.groups = "drop"
) %>%
mutate(label = paste0("p = ", signif(p.value, 3)))
mcp_labels <- mcp_long %>%
group_by(cell_population) %>%
summarise(
y = max(score, na.rm = TRUE) * 0.9,
x = 1,
.groups = "drop"
) %>%
left_join(mcp_pvals, by = "cell_population")
p_mcp <- ggplot(mcp_long, aes(x = immune_group, y = score, fill = immune_group)) +
geom_boxplot(outlier.shape = NA) +
geom_jitter(width = 0.15, size = 0.8, alpha = 0.7) +
facet_wrap(~ cell_population, scales = "free_y") +
theme_classic() +
theme(legend.position = "none") +
labs(
x = "Immune score group",
y = "MCP-counter score",
title = "MCP-counter cell populations by immune score group"
) +
scale_fill_manual(values = c("Low" = "#4575B4", "High" = "#D73027")) +
geom_text(
data = mcp_labels,
aes(x = x, y = y, label = label),
inherit.aes = FALSE,
hjust = 0,
vjust = 1,
size = 3
)
ggsave(
file.path(outdir, "MCPcounter_boxplots.png"),
p_mcp, width = 12, height = 8, dpi = 300
)
# -----------------------------
# 16) MCP-counter heatmap with clustering
# -----------------------------
mcp_mat <- as.matrix(mcp_scores)
# Make sure samples are in the same order as metadata
mcp_mat <- mcp_mat[, rownames(meta_prad), drop = FALSE]
ann_col <- data.frame(
immune_group = meta_prad$immune_group
)
rownames(ann_col) <- rownames(meta_prad)
png(
file.path(outdir, "MCPcounter_heatmap.png"),
width = 10, height = 7, units = "in", res = 300
)
pheatmap(
mcp_mat,
scale = "row",
annotation_col = ann_col,
show_colnames = FALSE,
clustering_distance_rows = "euclidean",
clustering_distance_cols = "euclidean",
main = "MCP-counter cell populations"
)
dev.off()
# -----------------------------
# 17) Correlation of MCP-counter scores with FOLH1
# -----------------------------
candidate <- "FOLH1"
if (candidate %in% rownames(logcpm)) {
folh1_expr <- as.numeric(logcpm[candidate, rownames(meta_prad)])
mcp_cor <- data.frame(
cell_population = rownames(mcp_mat),
rho = NA_real_,
p.value = NA_real_
)
for (i in seq_len(nrow(mcp_mat))) {
ct <- cor.test(
as.numeric(mcp_mat[i, ]),
folh1_expr,
method = "spearman"
)
mcp_cor$rho[i] <- unname(ct$estimate)
mcp_cor$p.value[i] <- ct$p.value
}
mcp_cor$adj.P.Val <- p.adjust(mcp_cor$p.value, method = "BH")
write.csv(mcp_cor, file.path(outdir, "MCPcounter_FOLH1_correlation.csv"), row.names = FALSE)
# Dot plot of correlations
mcp_cor$cell_population <- factor(
mcp_cor$cell_population,
levels = mcp_cor$cell_population[order(mcp_cor$rho)]
)
p_cor <- ggplot(mcp_cor, aes(x = rho, y = cell_population)) +
geom_point(aes(size = -log10(adj.P.Val), color = rho)) +
scale_color_gradient2(low = "#4575B4", mid = "grey90", high = "#D73027", midpoint = 0) +
theme_classic() +
labs(
title = paste0("Correlation of MCP-counter scores with ", candidate),
x = "Spearman rho",
y = "Cell population",
size = "-log10(FDR)",
color = "rho"
)
ggsave(
file.path(outdir, paste0("MCPcounter_", candidate, "_correlation_dotplot.png")),
p_cor, width = 8, height = 6, dpi = 300
)
# Optional individual scatterplots for significant populations
sig_cor <- mcp_cor %>% dplyr::filter(adj.P.Val < 0.05)
if (nrow(sig_cor) > 0) {
for (cell in sig_cor$cell_population) {
plot_df <- data.frame(
FOLH1 = folh1_expr,
score = as.numeric(mcp_mat[as.character(cell), ])
)
ct <- cor.test(plot_df$FOLH1, plot_df$score, method = "spearman")
p_scatter <- ggplot(plot_df, aes(FOLH1, score)) +
geom_point() +
geom_smooth(method = "lm", se = FALSE, color = "black") +
theme_classic() +
labs(
title = paste0(cell, " vs ", candidate),
x = paste0(candidate, " logCPM"),
y = "MCP-counter score"
) +
annotate(
"text",
x = -Inf, y = Inf,
label = paste0(
"rho = ", signif(unname(ct$estimate), 3),
"\np = ", signif(ct$p.value, 3)
),
hjust = -0.1, vjust = 1.1, size = 4
)
safe_name <- gsub("[^A-Za-z0-9_]", "_", cell)
ggsave(
file.path(outdir, paste0("MCPcounter_scatter_", safe_name, "_vs_", candidate, ".png")),
p_scatter, width = 5, height = 5, dpi = 300
)
}
}
}
# -----------------------------
# 18) Survival analysis using MCP-counter cell populations
# -----------------------------
time_col <- intersect(c("days_to_death", "days_to_last_follow_up"), colnames(meta_prad))
event_col <- intersect(c("vital_status"), colnames(meta_prad))
if (length(time_col) > 0 && length(event_col) > 0) {
meta_prad$time <- ifelse(
!is.na(meta_prad$days_to_death) & meta_prad$days_to_death > 0,
as.numeric(meta_prad$days_to_death),
as.numeric(meta_prad$days_to_last_follow_up)
)
meta_prad$event <- ifelse(meta_prad$vital_status == "Dead", 1, 0)
mcp_surv_stats <- data.frame(
cell_population = rownames(mcp_mat),
p.value = NA_real_,
HR = NA_real_
)
for (i in seq_len(nrow(mcp_mat))) {
cell <- rownames(mcp_mat)[i]
scores <- as.numeric(mcp_mat[i, rownames(meta_prad)])
group <- ifelse(scores >= median(scores, na.rm = TRUE), "High", "Low")
group <- factor(group, levels = c("Low", "High"))
surv_df <- data.frame(
time = meta_prad$time,
event = meta_prad$event,
group = group
)
if (sum(!is.na(surv_df$time) & !is.na(surv_df$event) & !is.na(surv_df$group)) > 10) {
fit_km <- survfit(Surv(time, event) ~ group, data = surv_df)
survdiff_res <- survdiff(Surv(time, event) ~ group, data = surv_df)
pval <- 1 - pchisq(survdiff_res$chisq, df = 1)
cox_fit <- coxph(Surv(time, event) ~ group, data = surv_df)
hr <- summary(cox_fit)$coefficients[1, "exp(coef)"]
mcp_surv_stats$p.value[i] <- pval
mcp_surv_stats$HR[i] <- hr
# Save KM plots only for nominally significant populations
if (!is.na(pval) && pval < 0.05) {
g <- ggsurvplot(
fit_km,
data = surv_df,
pval = TRUE,
risk.table = TRUE,
title = paste0("Survival by ", cell, " MCP-counter score"),
legend.title = cell,
legend.labs = c("Low", "High")
)
safe_name <- gsub("[^A-Za-z0-9_]", "_", cell)
ggsave(
file.path(outdir, paste0("KM_MCPcounter_", safe_name, ".png")),
plot = g$plot,
width = 7,
height = 6,
dpi = 300
)
}
}
}
mcp_surv_stats$adj.P.Val <- p.adjust(mcp_surv_stats$p.value, method = "BH")
write.csv(
mcp_surv_stats,
file.path(outdir, "MCPcounter_survival_stats.csv"),
row.names = FALSE
)
}
# -----------------------------
# 18) Survival analysis with KM plots for MCP-counter scores
# -----------------------------
