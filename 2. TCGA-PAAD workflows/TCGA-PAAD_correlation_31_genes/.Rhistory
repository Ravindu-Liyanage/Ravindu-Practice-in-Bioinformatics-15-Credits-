# Extract assay and metadata
count_mat <- assay(data)
meta_all <- as.data.frame(colData(data))
gene_annot <- as.data.frame(rowData(data))
# Add sample IDs explicitly
meta_all$SampleID <- rownames(meta_all)
# Keep only PAAD samples
meta_paad <- meta_all[meta_all$project == "TCGA-PAAD", , drop = FALSE]
# Keep only PAAD sample IDs that are present in the count matrix
common_samples <- intersect(colnames(count_mat), meta_paad$SampleID)
# Subset both expression and metadata to the same samples
count_mat_paad <- count_mat[, common_samples, drop = FALSE]
meta_paad <- meta_paad[match(common_samples, meta_paad$SampleID), , drop = FALSE]
# Check alignment
stopifnot(all(colnames(count_mat_paad) == meta_paad$SampleID))
# Match gene annotation to count matrix rows
gene_annot_paad <- gene_annot[rownames(count_mat_paad), , drop = FALSE]
# Save gene annotation
write.csv(gene_annot_paad, file = file.path(outdir, "PAAD_gene_annotation.csv"), row.names = FALSE)
# Find PIP5K1A row
pip_row <- which(gene_annot_paad$gene_name == "PIP5K1A")
if (length(pip_row) == 0) stop("PIP5K1A not found in rowData.")
if (length(pip_row) > 1) pip_row <- pip_row[1]
# Use log2(count + 1) for expression scale
expr_log <- log2(count_mat_paad + 1)
# Build PIP5K1A expression table
pip5k1a_df <- data.frame(
SampleID = common_samples,
PIP5K1A = as.numeric(expr_log[pip_row, ]),
stringsAsFactors = FALSE
)
# Select the ESTIMATE-related columns from the full metadata
score_cols <- c(
"paper_ABSOLUTE.purity",
"paper_ESTIMATE.immune.score",
"paper_ESTIMATE.stromal.score"
)
score_cols <- intersect(score_cols, colnames(meta_paad))
if (length(score_cols) == 0) stop("None of the requested score columns were found.")
scores_df <- meta_paad[, c("SampleID", score_cols), drop = FALSE]
View(scores_df)
# Inspect if they are already numeric
for (nm in score_cols) {
if (!is.numeric(scores_df[[nm]])) {
scores_df[[nm]] <- suppressWarnings(as.numeric(as.character(scores_df[[nm]])))
}
}
# Merge PIP5K1A expression with scores
corr_df <- inner_join(pip5k1a_df, scores_df, by = "SampleID")
View(corr_df)
library(TCGAbiolinks)
library(DESeq2)
library(SummarizedExperiment)
library(dplyr)
library(tidyr)
library(ggplot2)
library(ggpubr)
library(openxlsx)
library(writexl)
outdir <- "output"
dir.create(outdir, showWarnings = FALSE, recursive = TRUE)
# Load object
data <- readRDS("TCGA_panCancer_FOLH1.rds")
# Extract assay and metadata
count_mat <- assay(data)
meta_all <- as.data.frame(colData(data))
gene_annot <- as.data.frame(rowData(data))
# Add sample IDs explicitly
meta_all$SampleID <- rownames(meta_all)
# Keep only PAAD samples
meta_paad <- meta_all[meta_all$project == "TCGA-PAAD", , drop = FALSE]
# Keep only PAAD sample IDs that are present in the count matrix
common_samples <- intersect(colnames(count_mat), meta_paad$SampleID)
# Subset both expression and metadata to the same samples
count_mat_paad <- count_mat[, common_samples, drop = FALSE]
meta_paad <- meta_paad[match(common_samples, meta_paad$SampleID), , drop = FALSE]
# Check alignment
stopifnot(all(colnames(count_mat_paad) == meta_paad$SampleID))
# Match gene annotation to count matrix rows
gene_annot_paad <- gene_annot[rownames(count_mat_paad), , drop = FALSE]
# Save gene annotation
write.csv(gene_annot_paad, file = file.path(outdir, "PAAD_gene_annotation.csv"), row.names = FALSE)
# Find PIP5K1A row
pip_row <- which(gene_annot_paad$gene_name == "PIP5K1A")
if (length(pip_row) == 0) stop("PIP5K1A not found in rowData.")
if (length(pip_row) > 1) pip_row <- pip_row[1]
# Use log2(count + 1) for expression scale
expr_log <- log2(count_mat_paad + 1)
# Build PIP5K1A expression table
pip5k1a_df <- data.frame(
SampleID = common_samples,
PIP5K1A = as.numeric(expr_log[pip_row, ]),
stringsAsFactors = FALSE
)
# Select the ESTIMATE-related columns from the full metadata
score_cols <- c(
"paper_ABSOLUTE.purity",
"paper_ESTIMATE.immune.score",
"paper_ESTIMATE.stromal.score"
)
score_cols <- intersect(score_cols, colnames(meta_paad))
if (length(score_cols) == 0) stop("None of the requested score columns were found.")
scores_df <- meta_paad[, c("SampleID", score_cols), drop = FALSE]
# Inspect if they are already numeric
for (nm in score_cols) {
if (!is.numeric(scores_df[[nm]])) {
scores_df[[nm]] <- suppressWarnings(as.numeric(as.character(scores_df[[nm]])))
}
}
# Merge PIP5K1A expression with scores
corr_df <- inner_join(pip5k1a_df, scores_df, by = "SampleID")
# Remove rows with missing values in expression or scores
corr_df <- corr_df %>% filter(!is.na(PIP5K1A))
# Correlation analysis
corr_vars <- setdiff(colnames(corr_df), c("SampleID", "PIP5K1A"))
corr_results <- lapply(corr_vars, function(v) {
x <- corr_df$PIP5K1A
y <- corr_df[[v]]
ok <- complete.cases(x, y)
if (sum(ok) < 3) {
return(data.frame(
Variable = v,
Rho = NA_real_,
P_value = NA_real_,
N = sum(ok),
stringsAsFactors = FALSE
))
}
ct <- cor.test(x[ok], y[ok], method = "spearman", exact = FALSE)
data.frame(
Variable = v,
Rho = unname(ct$estimate),
P_value = ct$p.value,
N = sum(ok),
stringsAsFactors = FALSE
)
}) %>% bind_rows()
# Add FDR
corr_results$FDR <- p.adjust(corr_results$P_value, method = "BH")
# Save results
write.csv(corr_results, file = file.path(outdir, "PIP5K1A_ESTIMATE_correlation_results.csv"), row.names = FALSE)
write.xlsx(corr_results, file = file.path(outdir, "PIP5K1A_ESTIMATE_correlation_results.xlsx"), rowNames = FALSE)
# Create publication-style table
display_table <- corr_results %>%
mutate(
Rho = round(Rho, 3),
P_value = signif(P_value, 3),
FDR = signif(FDR, 3)
) %>%
select(Variable, Rho, P_value, FDR, N)
write.xlsx(display_table, file = file.path(outdir, "PIP5K1A_ESTIMATE_table.xlsx"), rowNames = FALSE)
# Optional plot
p <- ggplot(corr_results, aes(x = reorder(Variable, Rho), y = Rho, fill = Rho)) +
geom_col(width = 0.7) +
coord_flip() +
scale_fill_gradient2(low = "blue", mid = "white", high = "red", midpoint = 0) +
theme_bw(base_size = 12) +
labs(
title = "PIP5K1A correlation with ESTIMATE-related scores in TCGA-PAAD",
x = NULL,
y = "Spearman rho"
)
ggsave(file.path(outdir, "PIP5K1A_ESTIMATE_correlation_plot.png"), p, width = 8, height = 5, dpi = 300)
View(corr_df)
head(meta_all$SampleID)
head(colnames(count_mat))
head(meta_all[meta_all$project == "TCGA-PAAD", c("SampleID", "paper_ESTIMATE.immune.score", "paper_ESTIMATE.stromal.score")])
library(TCGAbiolinks)
library(DESeq2)
library(SummarizedExperiment)
library(dplyr)
library(tidyr)
library(ggplot2)
library(ggpubr)
library(openxlsx)
library(writexl)
outdir <- "output"
dir.create(outdir, showWarnings = FALSE, recursive = TRUE)
data <- readRDS("TCGA_panCancer_FOLH1.rds")
count_mat <- assay(data)
meta_all <- as.data.frame(colData(data))
gene_annot <- as.data.frame(rowData(data))
meta_all$SampleID <- rownames(meta_all)
# Keep PAAD samples
meta_paad <- meta_all[meta_all$project == "TCGA-PAAD", , drop = FALSE]
# Score columns
score_cols <- c(
"paper_ABSOLUTE.purity",
"paper_ESTIMATE.immune.score",
"paper_ESTIMATE.stromal.score"
)
score_cols <- intersect(score_cols, colnames(meta_paad))
if (length(score_cols) == 0) stop("No score columns found.")
# Keep only PAAD rows with at least one non-missing score
score_df_raw <- meta_paad[, c("SampleID", score_cols), drop = FALSE]
keep_scores <- rowSums(!is.na(score_df_raw[, score_cols, drop = FALSE])) > 0
score_df_raw <- score_df_raw[keep_scores, , drop = FALSE]
# Align expression samples to score samples
common_samples <- intersect(colnames(count_mat), score_df_raw$SampleID)
count_mat_paad <- count_mat[, common_samples, drop = FALSE]
score_df_raw <- score_df_raw[match(common_samples, score_df_raw$SampleID), , drop = FALSE]
# Keep only aligned rows
stopifnot(all(colnames(count_mat_paad) == score_df_raw$SampleID))
# Gene annotation
gene_annot_paad <- gene_annot[rownames(count_mat_paad), , drop = FALSE]
write.csv(gene_annot_paad, file = file.path(outdir, "PAAD_gene_annotation.csv"), row.names = FALSE)
# PIP5K1A row
pip_row <- which(gene_annot_paad$gene_name == "PIP5K1A")
if (length(pip_row) == 0) stop("PIP5K1A not found.")
if (length(pip_row) > 1) pip_row <- pip_row[1]
# Expression
expr_log <- log2(count_mat_paad + 1)
pip5k1a_df <- data.frame(
SampleID = common_samples,
PIP5K1A = as.numeric(expr_log[pip_row, ]),
stringsAsFactors = FALSE
)
# Clean score columns
scores_df <- score_df_raw
for (nm in score_cols) {
if (!is.numeric(scores_df[[nm]])) {
scores_df[[nm]] <- suppressWarnings(as.numeric(as.character(scores_df[[nm]])))
}
}
# Remove rows where all score columns are NA
scores_df <- scores_df[rowSums(!is.na(scores_df[, score_cols, drop = FALSE])) > 0, , drop = FALSE]
# Merge
corr_df <- inner_join(pip5k1a_df, scores_df, by = "SampleID")
# Drop samples with missing PIP5K1A
corr_df <- corr_df %>% filter(!is.na(PIP5K1A))
# Correlations
corr_vars <- setdiff(colnames(corr_df), c("SampleID", "PIP5K1A"))
corr_results <- lapply(corr_vars, function(v) {
x <- corr_df$PIP5K1A
y <- corr_df[[v]]
ok <- complete.cases(x, y)
if (sum(ok) < 3) {
return(data.frame(Variable = v, Rho = NA_real_, P_value = NA_real_, N = sum(ok)))
}
ct <- cor.test(x[ok], y[ok], method = "spearman", exact = FALSE)
data.frame(
Variable = v,
Rho = unname(ct$estimate),
P_value = ct$p.value,
N = sum(ok)
)
}) %>% bind_rows()
corr_results$FDR <- p.adjust(corr_results$P_value, method = "BH")
write.csv(corr_results, file = file.path(outdir, "PIP5K1A_ESTIMATE_correlation_results.csv"), row.names = FALSE)
write.xlsx(corr_results, file = file.path(outdir, "PIP5K1A_ESTIMATE_correlation_results.xlsx"), rowNames = FALSE)
display_table <- corr_results %>%
mutate(
Rho = round(Rho, 3),
P_value = signif(P_value, 3),
FDR = signif(FDR, 3)
) %>%
select(Variable, Rho, P_value, FDR, N)
write.xlsx(display_table, file = file.path(outdir, "PIP5K1A_ESTIMATE_table.xlsx"), rowNames = FALSE)
p <- ggplot(corr_results, aes(x = reorder(Variable, Rho), y = Rho, fill = Rho)) +
geom_col(width = 0.7) +
coord_flip() +
scale_fill_gradient2(low = "blue", mid = "white", high = "red", midpoint = 0) +
theme_bw(base_size = 12) +
labs(
title = "PIP5K1A correlation with ESTIMATE-related scores in TCGA-PAAD",
x = NULL,
y = "Spearman rho"
)
ggsave(file.path(outdir, "PIP5K1A_ESTIMATE_correlation_plot.png"), p, width = 8, height = 5, dpi = 300)
View(corr_df)
library(TCGAbiolinks)
library(DESeq2)
library(SummarizedExperiment)
library(dplyr)
library(tidyr)
library(ggplot2)
library(ggpubr)
library(openxlsx)
library(writexl)
outdir <- "output"
dir.create(outdir, showWarnings = FALSE, recursive = TRUE)
# Load data
data <- readRDS("TCGA_panCancer_FOLH1.rds")
count_mat <- assay(data)
meta <- as.data.frame(colData(data))
# Extract PAAD samples
meta_paad <- meta[meta$project == "TCGA-PAAD", ]
# Get PAAD count matrix
paad_counts <- count_mat[, rownames(meta_paad)]
# Get gene annotation
gene_annot <- as.data.frame(rowData(data))
gene_annot_paad <- gene_annot[rownames(paad_counts), ]
# Save annotation
write.csv(gene_annot_paad,
file = paste0(outdir, "/PAAD_gene_annotation.csv"),
row.names = FALSE)
# Make a lookup table: Ensembl IDs (with version) -> gene symbols
gene_map <- data.frame(
ensembl_id = rownames(gene_annot_paad),
gene_name = gene_annot_paad$gene_name,
stringsAsFactors = FALSE
)
# Remove missing or blank gene names
gene_map <- gene_map[!is.na(gene_map$gene_name) & gene_map$gene_name != "", ]
# Keep only one row per gene symbol if duplicates exist
gene_map <- gene_map[!duplicated(gene_map$gene_name), ]
# Your gene list
gene_list <- c(
"RIT1", "KRAS", "NF1", "PIK3CA", "VEGFA", "AKT3", "FLT1", "MAP2K1", "EGFR", "BRAF",
"TSC1", "PIK3R1", "ROS1", "MET", "NRAS", "CCNA1", "CCND1", "PTEN", "KDR", "MMP9",
"EGF", "AKT2", "ALK", "RET", "TP53", "ERBB2", "TSC2", "AKT1", "HRAS", "STK11"
)
target <- "PIP5K1A"
# Add target to list if not already there
all_genes <- unique(c(target, gene_list))
# Match requested symbols to annotation
keep_map <- gene_map[gene_map$gene_name %in% all_genes, ]
# Subset expression matrix by matching Ensembl IDs
paad_counts_sub <- paad_counts[keep_map$ensembl_id, , drop = FALSE]
# Replace row names with gene symbols
rownames(paad_counts_sub) <- keep_map$gene_name
# Check which genes were found/missing
found_genes <- rownames(paad_counts_sub)
missing_genes <- setdiff(all_genes, found_genes)
write.csv(data.frame(found_genes = found_genes),
file = paste0(outdir, "/found_genes.csv"),
row.names = FALSE)
write.csv(data.frame(missing_genes = missing_genes),
file = paste0(outdir, "/missing_genes.csv"),
row.names = FALSE)
# Correlation against PIP5K1A
target_vec <- as.numeric(paad_counts_sub[target, ])
corr_res <- do.call(rbind, lapply(gene_list, function(g) {
if (!g %in% rownames(paad_counts_sub)) {
return(data.frame(gene = g, rho = NA, p.value = NA))
}
x <- as.numeric(paad_counts_sub[g, ])
ct <- cor.test(x, target_vec, method = "spearman", use = "complete.obs")
data.frame(gene = g, rho = unname(ct$estimate), p.value = ct$p.value)
}))
corr_res <- corr_res[order(corr_res$p.value), ]
write.csv(corr_res,
file = paste0(outdir, "/PIP5K1A_31gene_correlations.csv"),
row.names = FALSE)
corr_res
View(paad_counts)
dds <- DESeqDataSetFromMatrix(
countData = paad_counts,
colData = meta_paad,
design = ~ 1
)
dds <- estimateSizeFactors(dds)
norm_counts <- counts(dds, normalized = TRUE)
vsd <- vst(dds, blind = TRUE)
vsd_mat <- assay(vsd)
gene_map <- gene_map[!is.na(gene_map$gene_name) & gene_map$gene_name != "", ]
gene_map <- gene_map[!duplicated(gene_map$gene_name), ]
# Gene list
gene_list <- c(
"RIT1", "KRAS", "NF1", "PIK3CA", "VEGFA", "AKT3", "FLT1", "MAP2K1", "EGFR", "BRAF",
"TSC1", "PIK3R1", "ROS1", "MET", "NRAS", "CCNA1", "CCND1", "PTEN", "KDR", "MMP9",
"EGF", "AKT2", "ALK", "RET", "TP53", "ERBB2", "TSC2", "AKT1", "HRAS", "STK11"
)
target <- "PIP5K1A"
all_genes <- unique(c(target, gene_list))
# Match requested symbols
keep_map <- gene_map[gene_map$gene_name %in% all_genes, ]
# Subset VST matrix by Ensembl IDs
vsd_sub <- vsd_mat[keep_map$ensembl_id, , drop = FALSE]
# Replace row names with gene symbols
rownames(vsd_sub) <- keep_map$gene_name
# Check which genes were found/missing
found_genes <- rownames(vsd_sub)
missing_genes <- setdiff(all_genes, found_genes)
write.csv(data.frame(found_genes = found_genes),
file = paste0(outdir, "/found_genes.csv"),
row.names = FALSE)
write.csv(data.frame(missing_genes = missing_genes),
file = paste0(outdir, "/missing_genes.csv"),
row.names = FALSE)
# Correlation against PIP5K1A using VST values
target_vec <- as.numeric(vsd_sub[target, ])
corr_res <- do.call(rbind, lapply(gene_list, function(g) {
if (!g %in% rownames(vsd_sub)) {
return(data.frame(gene = g, rho = NA, p.value = NA))
}
x <- as.numeric(vsd_sub[g, ])
ct <- cor.test(x, target_vec, method = "spearman", use = "complete.obs")
data.frame(gene = g, rho = unname(ct$estimate), p.value = ct$p.value)
}))
corr_res <- corr_res[order(corr_res$p.value), ]
write.csv(corr_res,
file = paste0(outdir, "/PIP5K1A_31gene_correlations_VST.csv"),
row.names = FALSE)
corr_res
library(dplyr)
