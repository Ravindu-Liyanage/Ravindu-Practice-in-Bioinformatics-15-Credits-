library(data.table)
# Get file names of the counts
path = "counts"
files = list.files(path, pattern="\\.tabular$", full.names = TRUE)
# Create loop that would load each counts file into R
for (f in files) {
x <- read.delim(f, header = TRUE, sep = "\t", stringsAsFactors = FALSE, check.names = FALSE)
gene_col <- 1
count_col <- ncol(x)
mat <- matrix(
as.numeric(x[[count_col]]),
ncol = 1,
dimnames = list(
make.unique(as.character(x[[gene_col]])),
tools::file_path_sans_ext(basename(f))
)
)
obj_name <- tools::file_path_sans_ext(basename(f))
obj_name <- sub("^Galaxy Column join on ", "", obj_name)
obj_name <- gsub("[^A-Za-z0-9_]", "_", obj_name)
obj_name <- paste0("counts_", obj_name)
assign(obj_name, mat, envir = .GlobalEnv)
}
