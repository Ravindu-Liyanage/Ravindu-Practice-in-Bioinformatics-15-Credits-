files
# create upload function
read_to_matrix <- function(file, gene_col = 1, count_col = NULL, na_to_zero = TRUE) {
dt <- fread(file, header = TRUE, data.table = FALSE)
if (is.null(count_col)) {
numeric_cols <- which(sapply(dt, is.numeric))
if (length(numeric_cols) == 0) stop("No numeric columns found - set count_col explicitly")
count_col <- tail(numeric_cols, 1)
}
genes <- as.character(dt[[gene_col]])
counts <- as.numeric(dt[[count_col]])
if (na_to_zero) counts[is.na(counts)] <- 0
mat <- matrix(counts, ncol = 1, dimnames = list(make.unique(genes), tools::file_path_sans_ext(basename(file))))
return(mat)
}
# load all as individual matrices in a named list
mat_list <- lapply(files, read_to_matrix)
