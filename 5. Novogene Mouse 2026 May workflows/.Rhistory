library(data.table)
# Get file names of the counts
path <- "counts"
files <- list.files(path, pattern = "\\.tabular$", full.names = TRUE)
for (f in files) {
x <- read.delim(f, header = TRUE, sep = "\t", stringsAsFactors = FALSE, check.names = FALSE)
gene_col <- 1
count_col <- NULL
# keep only numeric sample columns if needed
numeric_cols <- which(sapply(x, is.numeric))
if (length(numeric_cols) == 0) stop(paste("No numeric columns found in", f))
# make one matrix per sample column, if your file has multiple samples
for (j in numeric_cols) {
mat <- matrix(
as.numeric(x[[j]]),
ncol = 1,
dimnames = list(make.unique(as.character(x[[gene_col]])),
names(x)[j])
)
obj_name <- paste0("counts_", tools::file_path_sans_ext(basename(f)), "_", names(x)[j])
obj_name <- gsub("[^A-Za-z0-9_]", "_", obj_name)
assign(obj_name, mat, envir = .GlobalEnv)
}
}
