MCP_USE_LOG_EXPRESSION <- FALSE
MIN_KM_PATIENTS <- 10
MIN_KM_EVENTS <- 3
MIN_EXPRESSION_LOG2_FPKM <- 1
MIN_EXPRESSION_SAMPLE_FRACTION <- 0.10
# -------------------------
# PLOT THEME
# -------------------------
theme_nature <- function(base_size = 14, base_family = "Arial") {
theme_classic(base_size = base_size, base_family = base_family) +
theme(
plot.title = element_text(face = "bold", hjust = 0.5, size = base_size + 2),
axis.title = element_text(face = "bold", colour = "black"),
axis.text = element_text(colour = "black"),
axis.line = element_line(linewidth = 0.7, colour = "black"),
axis.ticks = element_line(linewidth = 0.6, colour = "black"),
legend.title = element_blank(),
legend.background = element_blank(),
legend.key = element_blank(),
panel.grid = element_blank(),
strip.background = element_rect(fill = "white", colour = "black"),
strip.text = element_text(face = "bold")
)
}
theme_set(theme_nature())
# -------------------------
# GENERAL HELPERS
# -------------------------
clean_names_simple <- function(x) {
x <- trimws(as.character(x))
x <- gsub("[[:space:]/-]+", "_", x)
x <- gsub("[^A-Za-z0-9_.]", "", x)
tolower(x)
}
find_column <- function(df, aliases) {
original <- colnames(df)
cleaned <- clean_names_simple(original)
aliases_clean <- clean_names_simple(aliases)
hit <- match(aliases_clean, cleaned)
hit <- hit[!is.na(hit)]
if (length(hit) > 0) return(original[hit[1]])
for (a in aliases_clean) {
idx <- grep(a, cleaned, fixed = TRUE)
if (length(idx) > 0) return(original[idx[1]])
}
NULL
}
read_cbioportal_table <- function(path) {
if (!file.exists(path)) stop("File not found: ", path)
x <- tryCatch(
data.table::fread(path, data.table = FALSE, check.names = FALSE, comment.char = "#"),
error = function(e) NULL
)
if (is.null(x) || ncol(x) < 2) {
x <- read.delim(
path, header = TRUE, sep = "\t", quote = "", comment.char = "#",
stringsAsFactors = FALSE, check.names = FALSE
)
}
x
}
standardize_gene_id <- function(x) {
x <- trimws(as.character(x))
x <- sub("\\|.*$", "", x)
x <- sub("\\..*$", "", x)
toupper(x)
}
extract_expression_matrix <- function(expr_df) {
first_col <- colnames(expr_df)[1]
gene_col <- find_column(expr_df, c(
"Hugo_Symbol", "Hugo Symbol", "gene", "Gene", "gene_symbol",
"Gene Symbol", "Entrez_Gene_Id", "Entrez Gene Id"
))
if (is.null(gene_col)) gene_col <- first_col
sample_cols <- setdiff(colnames(expr_df), gene_col)
sample_cols <- sample_cols[vapply(expr_df[sample_cols], function(z) {
any(!is.na(suppressWarnings(as.numeric(as.character(z)))))
}, logical(1))]
if (length(sample_cols) < 3) stop("Could not identify at least three numeric sample columns.")
genes <- standardize_gene_id(expr_df[[gene_col]])
keep <- !is.na(genes) & genes != "" & genes != "NA"
mat <- as.matrix(expr_df[keep, sample_cols, drop = FALSE])
suppressWarnings(storage.mode(mat) <- "numeric")
rownames(mat) <- genes[keep]
if (anyDuplicated(rownames(mat))) {
med <- apply(mat, 1, function(z) {
z <- z[is.finite(z)]
if (length(z) == 0) return(-Inf)
median(z)
})
ord <- order(rownames(mat), -med)
mat <- mat[ord, , drop = FALSE]
mat <- mat[!duplicated(rownames(mat)), , drop = FALSE]
}
list(mat = mat, gene_column = gene_col, sample_columns = sample_cols)
}
safe_filename <- function(x) {
x <- gsub("[^A-Za-z0-9]+", "_", x)
gsub("_+$", "", x)
}
safe_p_adjust <- function(p_values, method = "BH") {
out <- rep(NA_real_, length(p_values))
ok <- is.finite(p_values)
if (any(ok)) out[ok] <- p.adjust(p_values[ok], method = method)
out
}
safe_mean <- function(x) {
x <- suppressWarnings(as.numeric(x))
x <- x[is.finite(x)]
if (length(x) == 0) NA_real_ else mean(x)
}
parse_os_event <- function(x) {
x <- tolower(trimws(as.character(x)))
event <- rep(NA_real_, length(x))
event[grepl("^1[:_]|deceas|dead|died", x)] <- 1
event[grepl("^0[:_]|living|alive", x)] <- 0
event[x %in% c("1", "yes", "true")] <- 1
event[x %in% c("0", "no", "false")] <- 0
event
}
# -------------------------
# Heatmap helper
# -------------------------
safe_pheatmap <- function(mat, filename, annotation_col = NULL, main = NULL,
width = 10, height = 7) {
if (is.null(mat) || nrow(mat) < 1 || ncol(mat) < 2) return(NULL)
mat <- as.matrix(mat)
storage.mode(mat) <- "numeric"
keep_rows <- apply(mat, 1, function(x) {
x <- x[is.finite(x)]
length(x) >= 2 && length(unique(x)) > 1
})
mat <- mat[keep_rows, , drop = FALSE]
if (nrow(mat) < 1) return(NULL)
if (!is.null(annotation_col)) {
annotation_col <- as.data.frame(annotation_col)
common_samples <- intersect(colnames(mat), rownames(annotation_col))
mat <- mat[, common_samples, drop = FALSE]
annotation_col <- annotation_col[common_samples, , drop = FALSE]
}
tryCatch(
pheatmap::pheatmap(mat, scale = "row", annotation_col = annotation_col,
show_colnames = FALSE, main = main, filename = filename,
width = width, height = height),
error = function(e) warning("Heatmap was not generated: ", conditionMessage(e))
)
}
# -------------------------
# Clinical subgroup helpers
# -------------------------
normalize_missing <- function(x) {
if (is.list(x)) {
x <- vapply(x, function(z) {
if (length(z) == 0 || all(is.na(z))) NA_character_
else paste(as.character(z), collapse = ";")
}, character(1))
}
x <- trimws(as.character(x))
x[tolower(x) %in% c("", "na", "n/a", "nan", "null", "not available",
"not reported", "unknown", "missing")] <- NA_character_
x
}
standardize_neuroendocrine <- function(x) {
x <- normalize_missing(x)
z <- tolower(x)
out <- rep(NA_character_, length(x))
out[z %in% c("yes", "y", "positive", "pos", "1", "true")] <- "Yes"
out[z %in% c("no", "n", "negative", "neg", "0", "false")] <- "No"
out
}
standardize_ets_fusion <- function(x) {
x <- normalize_missing(x)
z <- tolower(x)
out <- rep(NA_character_, length(x))
out[z %in% c("positive", "pos", "yes", "y", "1", "true")] <- "Positive"
out[z %in% c("negative", "neg", "no", "n", "0", "false")] <- "Negative"
out
}
parse_gleason_score <- function(x) {
x <- normalize_missing(x)
x <- gsub("\\s+", "", x)
score <- suppressWarnings(as.numeric(x))
idx <- is.na(score) & !is.na(x)
score[idx] <- suppressWarnings(as.numeric(sub("^.*?([0-9]+).*?$", "\\1", x[idx])))
score
}
run_clinical_subgroup_analysis <- function(data, group_col, group_type, output_dir,
file_prefix, title_text, min_group_n = 2,
adjust_method = "BH") {
if (is.null(group_col) || !group_col %in% colnames(data)) {
writeLines(paste0("Clinical column not found: ", group_type),
file.path(output_dir, paste0(file_prefix, "_status.txt")))
return(list(summary = data.frame(), test = data.frame(), plot = NULL, data = data.frame()))
}
group_values <- data[[group_col]]
if (is.list(group_values)) {
group_values <- vapply(group_values, function(z) {
if (length(z) == 0 || all(is.na(z))) NA_character_
else paste(as.character(z), collapse = ";")
}, character(1))
}
d <- data.frame(
sample_id = as.character(data$sample_id),
patient_id = as.character(data$patient_id),
group = as.character(group_values),
FOLH1_log2_FPKM = suppressWarnings(as.numeric(data$FOLH1_log2_FPKM)),
stringsAsFactors = FALSE,
check.names = FALSE
)
d$group <- normalize_missing(d$group)
if (group_type == "Neuroendocrine features") d$group <- standardize_neuroendocrine(d$group)
if (group_type == "ETS fusion status") d$group <- standardize_ets_fusion(d$group)
if (group_type == "Gleason score") {
gleason_numeric <- parse_gleason_score(d$group)
d$group <- dplyr::case_when(
is.na(gleason_numeric) ~ NA_character_,
gleason_numeric <= 6 ~ "Low",
gleason_numeric == 7 ~ "Intermediate",
gleason_numeric >= 8 ~ "High",
TRUE ~ NA_character_
)
}
d <- d %>% dplyr::filter(!is.na(group), group != "", is.finite(FOLH1_log2_FPKM))
write.csv(d, file.path(output_dir, paste0(file_prefix, "_sample_level_data.csv")), row.names = FALSE)
if (nrow(d) == 0) {
writeLines(paste0("No usable observations for ", group_type),
file.path(output_dir, paste0(file_prefix, "_status.txt")))
return(list(summary = data.frame(), test = data.frame(), plot = NULL, data = d))
}
if (group_type == "Gleason score") {
d$group <- factor(d$group, levels = c("Low", "Intermediate", "High"), ordered = TRUE)
} else if (group_type == "ETS fusion status") {
d$group <- factor(d$group, levels = c("Negative", "Positive"), ordered = TRUE)
} else if (group_type == "Neuroendocrine features") {
d$group <- factor(d$group, levels = c("No", "Yes"), ordered = TRUE)
} else {
d$group <- factor(d$group)
}
group_counts <- d %>% dplyr::count(group, name = "n")
summary_df <- d %>%
dplyr::group_by(group) %>%
dplyr::summarise(
n = dplyr::n(),
mean_FOLH1_log2_FPKM = mean(FOLH1_log2_FPKM),
sd_FOLH1_log2_FPKM = if (dplyr::n() > 1) sd(FOLH1_log2_FPKM) else NA_real_,
median_FOLH1_log2_FPKM = median(FOLH1_log2_FPKM),
min_FOLH1_log2_FPKM = min(FOLH1_log2_FPKM),
max_FOLH1_log2_FPKM = max(FOLH1_log2_FPKM),
.groups = "drop"
)
write.csv(group_counts, file.path(output_dir, paste0(file_prefix, "_group_counts.csv")), row.names = FALSE)
write.csv(summary_df, file.path(output_dir, paste0(file_prefix, "_expression_summary.csv")), row.names = FALSE)
valid_groups <- group_counts %>% dplyr::filter(n >= min_group_n) %>% dplyr::pull(group)
test_df <- d %>% dplyr::filter(group %in% valid_groups) %>% droplevels()
test_result <- data.frame()
if (nrow(test_df) >= 3 && dplyr::n_distinct(test_df$group) >= 2) {
if (group_type == "Gleason score") {
kw <- kruskal.test(FOLH1_log2_FPKM ~ group, data = test_df)
test_result <- data.frame(
test = "Kruskal-Wallis",
grouping = "Low vs Intermediate vs High",
n = nrow(test_df),
n_groups = dplyr::n_distinct(test_df$group),
statistic = unname(kw$statistic),
p_value = kw$p.value,
p_adj_BH = kw$p.value
)
writeLines(capture.output(kw), file.path(output_dir, paste0(file_prefix, "_Kruskal_Wallis.txt")))
if (is.finite(kw$p.value) && kw$p.value < 0.05 && dplyr::n_distinct(test_df$group) >= 3) {
dunn <- test_df %>%
rstatix::dunn_test(FOLH1_log2_FPKM ~ group, p.adjust.method = adjust_method) %>%
dplyr::arrange(p.adj)
write.csv(dunn, file.path(output_dir, paste0(file_prefix, "_Dunn_BH_pairwise_tests.csv")), row.names = FALSE)
}
} else if (dplyr::n_distinct(test_df$group) == 2) {
wt <- wilcox.test(FOLH1_log2_FPKM ~ group, data = test_df, exact = FALSE)
test_result <- data.frame(
test = "Wilcoxon rank-sum",
grouping = paste(levels(test_df$group), collapse = " vs "),
n = nrow(test_df),
n_groups = 2,
statistic = unname(wt$statistic),
p_value = wt$p.value,
p_adj_BH = wt$p.value
)
writeLines(capture.output(wt), file.path(output_dir, paste0(file_prefix, "_Wilcoxon_rank_sum.txt")))
}
} else {
writeLines("Statistical testing skipped: insufficient group sizes.",
file.path(output_dir, paste0(file_prefix, "_test_status.txt")))
}
subtitle <- if (nrow(test_result) > 0) {
paste0(test_result$test[1], " p = ", format.pval(test_result$p_value[1], digits = 3, eps = 1e-3))
} else "Statistical test not available"
group_levels <- levels(d$group)
palette_values <- if (group_type == "Gleason score") {
c(Low = "#4DBBD5FF", Intermediate = "#EFC000FF", High = "#E64B35FF")
} else if (group_type == "ETS fusion status") {
c(Negative = "#4DBBD5FF", Positive = "#E64B35FF")
} else if (group_type == "Neuroendocrine features") {
c(No = "#4DBBD5FF", Yes = "#E64B35FF")
} else {
vals <- grDevices::hcl.colors(length(group_levels), palette = "Dark 3")
setNames(vals, group_levels)
}
p <- ggplot(d, aes(group, FOLH1_log2_FPKM, fill = group)) +
geom_boxplot(width = 0.65, outlier.shape = NA, alpha = 0.80) +
geom_jitter(width = 0.14, size = 1.6, alpha = 0.70) +
stat_summary(fun = mean, geom = "point", shape = 23, size = 3, fill = "white") +
scale_fill_manual(values = palette_values, limits = group_levels, drop = FALSE) +
labs(title = title_text, subtitle = subtitle, x = group_type,
y = "FOLH1 expression (log2(FPKM + 1))") +
theme_nature() + theme(legend.position = "none")
ggsave(file.path(output_dir, paste0(file_prefix, "_boxplot.png")), p,
width = max(6, min(12, 1.4 * length(group_levels) + 4)), height = 6, dpi = 300)
if (nrow(test_result) > 0) {
write.csv(test_result, file.path(output_dir, paste0(file_prefix, "_statistical_test.csv")), row.names = FALSE)
}
list(summary = summary_df, test = test_result, plot = p, data = d)
}
# -------------------------
# LOAD CLINICAL DATA
# -------------------------
clinical <- read_cbioportal_table(clinical_file)
clinical <- clinical[!grepl("^#", as.character(clinical[[1]])), , drop = FALSE]
sample_col <- find_column(clinical, c("SAMPLE_ID", "Sample Identifier", "Sample ID", "sample_id", "sample"))
patient_col <- find_column(clinical, c("PATIENT_ID", "Patient Identifier", "Patient ID", "patient_id", "patient"))
if (is.null(sample_col)) stop("No sample identifier column found in sample clinical data.")
clinical_wide <- clinical
is_long_clinical <- ncol(clinical) >= 3 && any(grepl("attribute|variable|clinical", clean_names_simple(colnames(clinical))))
if (is_long_clinical) {
attr_col <- find_column(clinical, c("ATTRIBUTE", "Attribute", "Clinical Attribute", "Variable", "Name"))
value_col <- find_column(clinical, c("VALUE", "Value", "Clinical Value", "Data", "Value Type"))
if (!is.null(attr_col) && !is.null(value_col)) {
clinical_long <- clinical %>%
dplyr::transmute(
sample_id = as.character(.data[[sample_col]]),
patient_id = if (!is.null(patient_col)) as.character(.data[[patient_col]]) else as.character(.data[[sample_col]]),
attribute = as.character(.data[[attr_col]]),
value = as.character(.data[[value_col]])
) %>% dplyr::filter(!is.na(sample_id), sample_id != "") %>% dplyr::distinct()
clinical_wide <- clinical_long %>%
tidyr::pivot_wider(names_from = attribute, values_from = value,
values_fn = ~ paste(unique(.x[!is.na(.x)]), collapse = ";"))
}
}
if (sample_col %in% colnames(clinical_wide)) colnames(clinical_wide)[colnames(clinical_wide) == sample_col] <- "sample_id"
if (!is.null(patient_col) && patient_col %in% colnames(clinical_wide)) colnames(clinical_wide)[colnames(clinical_wide) == patient_col] <- "patient_id"
if (!"sample_id" %in% colnames(clinical_wide)) clinical_wide$sample_id <- NA_character_
if (!"patient_id" %in% colnames(clinical_wide)) clinical_wide$patient_id <- clinical_wide$sample_id
clinical_wide <- clinical_wide %>%
dplyr::mutate(sample_id = as.character(sample_id), patient_id = as.character(patient_id)) %>%
dplyr::filter(!is.na(sample_id), sample_id != "") %>%
dplyr::distinct(sample_id, .keep_all = TRUE)
# -------------------------
# PATIENT OS DATA
# -------------------------
clinical_patient <- read_cbioportal_table(clinical_patient_file)
clinical_patient <- clinical_patient[!grepl("^#", as.character(clinical_patient[[1]])), , drop = FALSE]
patient_id_col <- find_column(clinical_patient, c("PATIENT_ID", "Patient Identifier", "Patient ID", "patient_id", "patient"))
os_status_col <- find_column(clinical_patient, c("OS_STATUS", "Overall Survival Status", "OS Status"))
os_months_col <- find_column(clinical_patient, c("OS_MONTHS", "Overall Survival Months", "Overall Survival (Months)", "OS Months"))
if (is.null(patient_id_col) || is.null(os_status_col) || is.null(os_months_col)) stop("Could not identify OS clinical columns.")
patient_os <- clinical_patient %>%
dplyr::transmute(patient_id = as.character(.data[[patient_id_col]]),
OS_STATUS_raw = as.character(.data[[os_status_col]]),
OS_MONTHS = suppressWarnings(as.numeric(.data[[os_months_col]]))) %>%
dplyr::filter(!is.na(patient_id), patient_id != "") %>%
dplyr::mutate(OS_EVENT = parse_os_event(OS_STATUS_raw)) %>%
dplyr::distinct(patient_id, .keep_all = TRUE)
clinical_wide <- clinical_wide %>% dplyr::left_join(patient_os, by = "patient_id")
write.csv(patient_os, file.path(tables_dir, "patient_level_OS_clinical_data.csv"), row.names = FALSE)
# -------------------------
# EXPRESSION ALIGNMENT
# -------------------------
expr_obj <- extract_expression_matrix(read_cbioportal_table(expression_file))
expr_mat <- expr_obj$mat
expr_mat_log <- if (EXPRESSION_IS_RAW_FPKM) log2(pmax(expr_mat, 0) + 1) else expr_mat
common_samples <- intersect(colnames(expr_mat_log), clinical_wide$sample_id)
if (length(common_samples) < 3) stop("Fewer than three samples matched between expression and clinical data.")
expr_mat <- expr_mat[, common_samples, drop = FALSE]
expr_mat_log <- expr_mat_log[, common_samples, drop = FALSE]
clinical_wide <- clinical_wide[match(common_samples, clinical_wide$sample_id), , drop = FALSE]
rownames(clinical_wide) <- clinical_wide$sample_id
sample_type_col <- find_column(clinical_wide, c("SAMPLE_TYPE", "Sample Type", "sample_type", "Tissue Type", "Specimen Type"))
if (KEEP_TUMOR_SAMPLES_ONLY && !is.null(sample_type_col)) {
sample_type <- tolower(as.character(clinical_wide[[sample_type_col]]))
keep <- !grepl("normal|control|blood|germline|non[-_ ]?tumor|adjacent", sample_type) | is.na(sample_type) | sample_type == ""
expr_mat <- expr_mat[, keep, drop = FALSE]
expr_mat_log <- expr_mat_log[, keep, drop = FALSE]
clinical_wide <- clinical_wide[keep, , drop = FALSE]
}
if (ONE_SAMPLE_PER_PATIENT) {
keep <- !duplicated(clinical_wide$patient_id)
keep[is.na(clinical_wide$patient_id) | clinical_wide$patient_id == ""] <- TRUE
expr_mat <- expr_mat[, keep, drop = FALSE]
expr_mat_log <- expr_mat_log[, keep, drop = FALSE]
clinical_wide <- clinical_wide[keep, , drop = FALSE]
}
rownames(clinical_wide) <- clinical_wide$sample_id
sample_ids <- colnames(expr_mat_log)
if (!identical(sample_ids, rownames(clinical_wide))) stop("Sample alignment failed.")
# -------------------------
# EXPRESSION SUMMARY AND CORRELATIONS
# -------------------------
if (!target_gene %in% rownames(expr_mat_log)) stop(target_gene, " was not found in expression matrix.")
biomarkers <- unique(toupper(biomarkers))
biomarkers_avail <- biomarkers[biomarkers %in% rownames(expr_mat_log)]
summary_genes <- unique(c(target_gene, biomarkers_avail))
biomarker_presence <- data.frame(gene = unique(c(target_gene, biomarkers)),
found_in_expression = unique(c(target_gene, biomarkers)) %in% rownames(expr_mat_log))
summary_df <- lapply(summary_genes, function(gene) {
x <- as.numeric(expr_mat_log[gene, sample_ids]); x <- x[is.finite(x)]
data.frame(gene = gene, n = length(x), mean_log2_fpkm = if (length(x)) mean(x) else NA_real_,
median_log2_fpkm = if (length(x)) median(x) else NA_real_,
sd_log2_fpkm = if (length(x) > 1) sd(x) else NA_real_)
}) %>% dplyr::bind_rows()
write.csv(biomarker_presence, file.path(tables_dir, "biomarker_presence_check.csv"), row.names = FALSE)
write.csv(summary_df, file.path(tables_dir, "mCRPC_expression_summary_log2_FPKM.csv"), row.names = FALSE)
spearman_cor_df <- cor_results(expr_mat_log, target_gene, biomarkers_avail, sample_ids, "spearman")
pearson_cor_df <- cor_results(expr_mat_log, target_gene, biomarkers_avail, sample_ids, "pearson")
write.csv(spearman_cor_df, file.path(tables_dir, "mCRPC_spearman_FOLH1_vs_biomarkers.csv"), row.names = FALSE)
write.csv(pearson_cor_df, file.path(tables_dir, "mCRPC_pearson_FOLH1_vs_biomarkers.csv"), row.names = FALSE)
invisible(lapply(biomarkers_avail, plot_gene_scatter, method = "spearman", output_dir = spearman_dir,
expression_matrix = expr_mat_log, sample_ids = sample_ids))
invisible(lapply(biomarkers_avail, plot_gene_scatter, method = "pearson", output_dir = pearson_dir,
expression_matrix = expr_mat_log, sample_ids = sample_ids))
# -------------------------
# CLINICAL SUBGROUP ANALYSES
# -------------------------
clinical_expression_df <- data.frame(
sample_id = as.character(sample_ids),
patient_id = as.character(clinical_wide[sample_ids, "patient_id"]),
FOLH1_log2_FPKM = as.numeric(expr_mat_log[target_gene, sample_ids]),
stringsAsFactors = FALSE,
check.names = FALSE
)
gleason_col <- find_column(clinical_wide, c("GLEASON_SCORE", "Gleason Score", "Gleason score", "gleason_score"))
neuroendocrine_col <- find_column(clinical_wide, c("NEUROENDOCRINE_FEATURES", "Neuroendocrine Features", "neuroendocrine_features"))
ets_fusion_col <- find_column(clinical_wide, c(
"ETS_FUSION_STATUS", "ETS Fusion Status", "ETS fusion status",
"ETS_FUSION_STATIUS", "ETS Fusion Statius", "ets_fusion_status",
"ETS_FUSION", "ETS Fusion", "ETS_STATUS", "ETS Status"
))
clinical_expression_df$GLEASON_SCORE <- if (!is.null(gleason_col)) as.character(clinical_wide[sample_ids, gleason_col]) else NA_character_
clinical_expression_df$NEUROENDOCRINE_FEATURES <- if (!is.null(neuroendocrine_col)) as.character(clinical_wide[sample_ids, neuroendocrine_col]) else NA_character_
clinical_expression_df$ETS_FUSION_STATUS <- if (!is.null(ets_fusion_col)) as.character(clinical_wide[sample_ids, ets_fusion_col]) else NA_character_
write.csv(clinical_expression_df, file.path(clinical_subgroup_dir, "FOLH1_expression_with_requested_clinical_variables.csv"), row.names = FALSE)
write.csv(data.frame(
requested_variable = c("GLEASON_SCORE", "NEUROENDOCRINE_FEATURES", "ETS_FUSION_STATUS"),
detected_column = c(ifelse(is.null(gleason_col), NA, gleason_col),
ifelse(is.null(neuroendocrine_col), NA, neuroendocrine_col),
ifelse(is.null(ets_fusion_col), NA, ets_fusion_col)),
raw_non_missing_values = c(
paste(unique(na.omit(clinical_expression_df$GLEASON_SCORE)), collapse = " | "),
paste(unique(na.omit(clinical_expression_df$NEUROENDOCRINE_FEATURES)), collapse = " | "),
paste(unique(na.omit(clinical_expression_df$ETS_FUSION_STATUS)), collapse = " | ")
)
), file.path(clinical_subgroup_dir, "clinical_column_detection_diagnostic.csv"), row.names = FALSE)
gleason_result <- run_clinical_subgroup_analysis(clinical_expression_df, "GLEASON_SCORE", "Gleason score", gleason_dir,
"FOLH1_by_Gleason_score", "FOLH1 expression by Gleason group")
neuroendocrine_result <- run_clinical_subgroup_analysis(clinical_expression_df, "NEUROENDOCRINE_FEATURES", "Neuroendocrine features", neuroendocrine_dir,
"FOLH1_by_neuroendocrine_features", "FOLH1 expression by neuroendocrine features")
ets_fusion_result <- run_clinical_subgroup_analysis(clinical_expression_df, "ETS_FUSION_STATUS", "ETS fusion status", ets_fusion_dir,
"FOLH1_by_ETS_fusion_status", "FOLH1 expression by ETS fusion status")
clinical_subgroup_test_results <- dplyr::bind_rows(
if (nrow(gleason_result$test) > 0) dplyr::mutate(gleason_result$test, analysis = "Gleason score") else data.frame(),
if (nrow(neuroendocrine_result$test) > 0) dplyr::mutate(neuroendocrine_result$test, analysis = "Neuroendocrine features") else data.frame(),
if (nrow(ets_fusion_result$test) > 0) dplyr::mutate(ets_fusion_result$test, analysis = "ETS fusion status") else data.frame()
)
if (nrow(clinical_subgroup_test_results) > 0) {
clinical_subgroup_test_results$p_adj_across_three_analyses_BH <- safe_p_adjust(clinical_subgroup_test_results$p_value)
}
write.csv(clinical_subgroup_test_results, file.path(clinical_subgroup_dir, "clinical_subgroup_statistical_tests.csv"), row.names = FALSE)
# -------------------------
# HEATMAP
# -------------------------
heat_genes <- unique(c(target_gene, biomarkers_avail))
annotation_col <- data.frame(Cohort = factor(rep("SU2C/PCF 2019", length(sample_ids))))
rownames(annotation_col) <- sample_ids
safe_pheatmap(expr_mat_log[heat_genes, sample_ids, drop = FALSE],
filename = file.path(heatmap_dir, "mCRPC_FOLH1_biomarker_heatmap.png"),
annotation_col = annotation_col,
main = "FOLH1 and biomarkers in SU2C/PCF 2019 mCRPC")
# -------------------------
# PATIENT-LEVEL OS DATA
# -------------------------
km_genes <- unique(c(target_gene, biomarkers_avail))
km_patient_df <- build_patient_expression_df(clinical_wide, expr_mat_log, km_genes)
write.csv(km_patient_df, file.path(km_dir, "patient_level_OS_expression_all_biomarkers.csv"), row.names = FALSE)
# -------------------------
# EXCEL WORKBOOK
# -------------------------
wb <- openxlsx::createWorkbook()
add_sheet_once <- function(sheet_name, data) {
if (is.null(data)) return(invisible(NULL))
data <- as.data.frame(data)
if (!(sheet_name %in% names(wb))) openxlsx::addWorksheet(wb, sheet_name)
openxlsx::writeData(wb, sheet_name, data, withFilter = nrow(data) > 0)
}
add_sheet_once("Biomarker_presence", biomarker_presence)
add_sheet_once("Expression_summary", summary_df)
add_sheet_once("Sample_metadata_OS", clinical_wide)
add_sheet_once("Patient_OS", patient_os)
add_sheet_once("Spearman_correlations", spearman_cor_df)
add_sheet_once("Pearson_correlations", pearson_cor_df)
add_sheet_once("Clinical_subgroup_tests", clinical_subgroup_test_results)
add_sheet_once("Gleason_summary", gleason_result$summary)
add_sheet_once("Neuroendocrine_summary", neuroendocrine_result$summary)
add_sheet_once("ETS_fusion_summary", ets_fusion_result$summary)
openxlsx::saveWorkbook(wb, file.path(outdir, "metastatic_only_FOLH1_analysis_results.xlsx"), overwrite = TRUE)
cat("\nAnalysis complete. Results written to: ", outdir, "\n", sep = "")
